FROM node:22-slim

RUN apt-get update -y && \
    apt-get install -y wget openssl procps && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /usr/app

# Copy dependency files first to leverage Docker layer caching
COPY package*.json ./
COPY prisma ./prisma

# Install dependencies
RUN npm install

# Copy the rest of the source code
COPY . .